<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_axi" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.axi</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='account']" position="inside">
                <h2>Ajuste por Inflación</h2>
                <div class="row mt16 o_settings_container" name="axi_settings_block">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Cuenta RECPAM</span>
                            <div class="text-muted">
                                Cuenta usada como contrapartida de los asientos de ajuste por inflación.
                            </div>
                            <field name="axi_recpam_account_id"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Etiqueta cuentas no monetarias</span>
                            <div class="text-muted">
                                Etiqueta que identifica las cuentas alcanzadas por la reexpresión.
                            </div>
                            <field name="axi_non_monetary_tag_id"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Diario de ajuste</span>
                            <div class="text-muted">
                                Diario propuesto por defecto al crear un batch. Se puede cambiar en cada batch.
                            </div>
                            <field name="axi_journal_id"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Diarios excluidos del reporte</span>
                            <div class="text-muted">
                                Diarios excluidos por defecto en el reporte de Sumas y Saldos Comparativo (ej: apertura, saldos iniciales).
                            </div>
                            <field name="axi_excluded_journal_ids" widget="many2many_tags"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
